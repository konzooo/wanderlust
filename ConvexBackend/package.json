{
  "name": "wanderlust-convex-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Convex backend for Wanderlust Group Trips",
  "scripts": {
    "dev": "convex dev",
    "deploy": "convex deploy",
    "typecheck": "tsc -p convex/tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.mts",
    "check": "npm run typecheck && npm test",
    "eval:kbyg": "esbuild tools/kbyg-eval.ts --bundle --platform=node --format=esm --outfile=tools/.build/kbyg-eval.mjs && node tools/.build/kbyg-eval.mjs"
  },
  "dependencies": {
    "@convex-dev/rate-limiter": "^0.3.2",
    "convex": "^1.44.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
