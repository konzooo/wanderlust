<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AmplitudeAPIKey</key>
	<string>$(AMPLITUDE_API_KEY)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.kk.wanderlust.grouptrip</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- Dev/testing scheme for group invite deep links
				     (wanderlust://join/<code>). Production uses Universal Links
				     once the associated domain is configured; onOpenURL handles both. -->
				<string>wanderlust</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>comgooglemaps</string>
		<string>maps</string>
	</array>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Use your location to place your stay on the map and find what is nearby.</string>
	<!-- The system launch screen must be static, so it cannot be the splash
	     itself — but it can be the splash's first frame. Painting it with the
	     aurora's top-left colour removes the white flash that otherwise sits
	     between the icon tap and the animation. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIAppFonts</key>
	<array>
		<string>Kanit-Medium.ttf</string>
		<string>Kanit-Light.ttf</string>
		<string>Kanit-Thin.ttf</string>
		<string>Kanit-Regular.ttf</string>
		<string>Kanit-Italic.ttf</string>
		<string>Kanit-MediumItalic.ttf</string>
		<string>Kanit-LightItalic.ttf</string>
		<string>Kanit-Bold.ttf</string>
		<string>Kanit-BoldItalic.ttf</string>
	</array>
</dict>
</plist>
